# Local dev: copy this file to .env and leave as-is if running the backend
# locally on port 8000.
#
# Netlify: do NOT rely on this file for the deployed site -- set
# VITE_API_URL in Netlify's dashboard (Site settings -> Environment
# variables) to your real Render backend URL instead. This file is only
# read for local `npm run dev`.

VITE_API_URL=http://localhost:8000
