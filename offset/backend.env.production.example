# Production reference only -- you will NOT paste real secrets into this
# file or commit it. Actual production values are set as environment
# variables in the Render dashboard (or automatically via render.yaml for
# DATABASE_URL and JWT_SECRET, which are provisioned/generated for you).
#
# This file exists so you can see what a real production value looks like,
# versus the dev-oriented root .env.example which uses SQLite and
# localhost. Keep both -- they serve different environments.

# Render provisions this automatically via render.yaml's fromDatabase
# reference. Shown here just so you know the shape to expect:
DATABASE_URL=postgresql://e_credits:PASSWORD@HOST/e_credits

# Render generates this automatically via render.yaml's generateValue: true.
# If setting manually instead, generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_REAL_GENERATED_SECRET_NEVER_THIS_PLACEHOLDER

# Set this in the Render dashboard AFTER your Netlify site is live --
# render.yaml ships with a localhost-only default since your Netlify URL
# doesn't exist yet at blueprint-creation time.
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:5173

# Optional -- only needed if you wire a real LLM endpoint for /ai/chat.
# Leave unset otherwise; the app works without it.
AI_CHAT_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
